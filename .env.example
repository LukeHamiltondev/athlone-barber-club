# Copy to .env (or set in your host's dashboard). Never commit the real values.

# Public URL the site is served on, no trailing slash. Twilio calls this.
PUBLIC_URL=https://athlonebarberclub.ie
PORT=3000

# Password for the owner's diary at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Anthropic API key (console.anthropic.com) - powers the phone receptionist
ANTHROPIC_API_KEY=
# Model for the phone receptionist. Default is claude-opus-5-5.
# AGENT_MODEL=claude-opus-5-5

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number customers call, in +353 format
TWILIO_PHONE_NUMBER=+353...
# Set to false only for local testing without Twilio signatures
TWILIO_VALIDATE_SIGNATURES=true

# Owner's own mobile. Used for "ring me first", transfers, and booking texts.
OWNER_MOBILE=+353...
# Ring the owner's mobile first for this many seconds before the AI answers. 0 = AI answers straight away.
RING_OWNER_FIRST_SECONDS=15
# Text the owner when the AI takes a booking or a message
NOTIFY_OWNER_BY_SMS=true
# Text customers a confirmation when they book
SMS_CUSTOMER_CONFIRMATIONS=true

# Voice settings for the receptionist
VOICE_LANGUAGE=en-GB
VOICE_TTS_PROVIDER=ElevenLabs
# VOICE_NAME=

# Where bookings are stored
DATA_DIR=./data
